# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=inventory_db

# Backend Configuration
JWT_SECRET_KEY=generate_a_secure_random_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Note: For docker-compose, this is overridden dynamically. 
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/inventory_db

# Frontend Configuration (If building locally outside docker-compose)
VITE_API_URL=http://localhost:8000/api
